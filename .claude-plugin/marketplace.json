{
  "$schema": "https://json.schemastore.org/claude-code-marketplace.json",
  "name": "ancplua-anthropic",
  "description": "ancplua's Claude plugins: the root of everything ANcpLua builds for Claude.",
  "owner": {
    "name": "ancplua"
  },
  "plugins": [
    {
      "name": "ancplua-docs",
      "source": "./plugins/ancplua-docs"
    },
    {
      "name": "ancplua-dotnet",
      "source": {
        "source": "url",
        "url": "https://github.com/ANcpLua/ancplua-dotnet.git"
      }
    },
    {
      "name": "ancplua-hunt",
      "source": "./plugins/ancplua-hunt"
    },
    {
      "name": "ancplua-lean-proof",
      "source": {
        "source": "url",
        "url": "https://github.com/ANcpLua/ancplua-lean-proof.git"
      }
    },
    {
      "name": "mcp-builder-v2",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/ANcpLua/mcp-builder-v2.git",
        "path": "plugins/mcp-builder-v2"
      }
    }
  ]
}
