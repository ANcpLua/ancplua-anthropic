{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun scripts/verify.mjs *)",
      "Bash(claude plugin validate *)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:claude.com)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop-verify.mjs"],
            "timeout": 120,
            "statusMessage": "verify.mjs"
          }
        ]
      }
    ]
  }
}
